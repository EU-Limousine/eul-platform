# Copy to .env (never commit .env). Used by packages/db, apps/api and apps/worker locally.
NODE_ENV=development

# Database (docker compose, port 5433)
DATABASE_URL=postgresql://eul:eul@localhost:5433/eul?schema=public
DB_POOL_MAX=5

# Redis (docker compose)
REDIS_URL=redis://localhost:6379

# Auth — JWT_ACCESS_SECRET must be at least 32 characters
JWT_ACCESS_SECRET=change-me-to-a-long-random-string-of-32-plus-chars
JWT_ACCESS_TTL=900
REFRESH_TTL_DAYS=14

# Comma-separated origins allowed to call the API with cookies
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# First super admin, created by `npm run db:seed`
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=change-me-please-123

# Email (local: mailpit from docker compose; production values come from Secret Manager). D-20
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
MAIL_FROM="EU Limousine <bookings@eulimousine.com>"

# Payments — D-01 open; fake provider until management names one
PAYMENT_PROVIDER=fake

# Cloudflare Turnstile (test secret always passes)
TURNSTILE_SECRET=1x0000000000000000000000000000000AA
