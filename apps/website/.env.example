# Website (Next.js) — public values only, never secrets.
NEXT_PUBLIC_API_URL=http://localhost:8080
SITE_URL=http://localhost:3000
# DKK, EUR or USD. Danish pages always start with DKK.
NEXT_PUBLIC_DEFAULT_CURRENCY=EUR
# classic = Homepage Option 1 (navy + champagne), noir = Option 2 (black + gold)
NEXT_PUBLIC_HOME_VARIANT=classic
