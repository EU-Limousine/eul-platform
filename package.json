{
  "name": "eul-platform",
  "private": true,
  "packageManager": "npm@10.9.9",
  "engines": {
    "node": ">=22 <23"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "db:seed": "npm run seed -w @eul/db",
    "api:generate": "npm run generate -w @eul/api-client",
    "db:generate": "npm run generate -w @eul/db --",
    "db:migrate": "npm run migrate -w @eul/db --",
    "db:migrate:status": "npm run migrate:status -w @eul/db",
    "db:studio": "npm run studio -w @eul/db"
  },
  "devDependencies": {
    "prettier": "^3.9.10",
    "turbo": "^2.11.9",
    "typescript": "^6.0.0"
  }
}