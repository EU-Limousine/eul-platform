// EU Limousine — database schema. Source of truth for every table.
// Rules: CLAUDE.md §4. Money = integer minor units + currency. Time = timestamptz (UTC).

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "cjs"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

// ───────────────────────── Enums ─────────────────────────

enum StaffRole {
  SUPER_ADMIN
  DEVELOPER
  ADMIN
  DISPATCHER
  DRIVER
}

enum CustomerRole {
  CUSTOMER
  CORPORATE_USER
  CORPORATE_ADMIN
}

enum BookingStatus {
  NEW
  PENDING_DISPATCH
  DRIVERS_NOTIFIED
  ASSIGNED
  DRIVER_EN_ROUTE
  ARRIVED
  IN_JOURNEY
  COMPLETED
  CANCELLED
  NEEDS_ATTENTION
}

enum BookingType {
  SAME_DAY
  FUTURE
}

enum Currency {
  DKK
  EUR
  USD
}

enum OfferStatus {
  SENT
  VIEWED
  ACCEPTED
  DECLINED
  EXPIRED
  CLOSED
}

enum OfferRound {
  REGULAR
  SPARE
}

enum OfferStrategy {
  BROADCAST
  SEQUENTIAL
}

enum AssignmentMethod {
  ACCEPTED
  MANUAL
}

enum DriverType {
  EMPLOYEE
  CONTRACTOR
}

enum CheckoutStatus {
  PENDING
  PAID
  FAILED
  EXPIRED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  CANCELLED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum RefundStatus {
  PENDING
  SUCCEEDED
  FAILED
}

enum NotificationChannel {
  EMAIL
  PUSH
  WEB_PUSH
  IN_APP
  SMS
  WHATSAPP
}

enum NotificationStatus {
  QUEUED
  SENT
  FAILED
}

// ───────────────────────── Staff identity ─────────────────────────

model User {
  id           String    @id @default(uuid()) @db.Uuid
  email        String    @unique
  passwordHash String    @map("password_hash")
  name         String
  phone        String?
  isActive     Boolean   @default(true) @map("is_active")
  lastLoginAt  DateTime? @map("last_login_at") @db.Timestamptz
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  roles         UserRole[]     @relation("UserRoles")
  rolesGranted  UserRole[]     @relation("RoleGrantedBy")
  refreshTokens RefreshToken[]
  driver        Driver?

  @@map("users")
}

model UserRole {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  role        StaffRole
  grantedById String?   @map("granted_by") @db.Uuid
  grantedAt   DateTime  @default(now()) @map("granted_at") @db.Timestamptz

  user      User  @relation("UserRoles", fields: [userId], references: [id], onDelete: Cascade)
  grantedBy User? @relation("RoleGrantedBy", fields: [grantedById], references: [id])

  @@unique([userId, role])
  @@map("user_roles")
}

model RefreshToken {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  tokenHash  String    @unique @map("token_hash")
  familyId   String    @map("family_id") @db.Uuid
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz
  usedAt     DateTime? @map("used_at") @db.Timestamptz
  userAgent  String?   @map("user_agent")
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([familyId])
  @@index([userId])
  @@map("refresh_tokens")
}

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  actorId    String?  @map("actor_id") @db.Uuid
  actorLabel String?  @map("actor_label") // e.g. "system" or "AI on behalf of <user>"
  action     String
  entityType String   @map("entity_type")
  entityId   String?  @map("entity_id")
  before     Json?
  after      Json?
  requestId  String?  @map("request_id")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

// ───────────────────────── Customer identity ─────────────────────────
// Separate from staff. Phase 1: guest booking, a row is found or created by email.

model Customer {
  id                String       @id @default(uuid()) @db.Uuid
  email             String       @unique
  name              String
  phone             String?
  role              CustomerRole @default(CUSTOMER)
  preferredLanguage String       @default("en") @map("preferred_language")
  createdAt         DateTime     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime     @updatedAt @map("updated_at") @db.Timestamptz

  bookings Booking[]

  @@map("customers")
}

// ───────────────────────── Fleet and drivers ─────────────────────────

model VehicleCategory {
  id            String   @id @default(uuid()) @db.Uuid
  code          String   @unique
  name          String
  exampleModel  String?  @map("example_model")
  maxPassengers Int      @map("max_passengers")
  luggageNote   String?  @map("luggage_note")
  description   String?
  sortOrder     Int      @default(0) @map("sort_order")
  isActive      Boolean  @default(true) @map("is_active")
  isConfirmed   Boolean  @default(false) @map("is_confirmed") // D-09: false until management confirms real fleet data
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz

  vehicles     Vehicle[]
  pricingRules PricingRule[]
  quotes       Quote[]
  bookings     Booking[]

  @@map("vehicle_categories")
}

model Vehicle {
  id          String   @id @default(uuid()) @db.Uuid
  categoryId  String   @map("category_id") @db.Uuid
  make        String
  model       String
  plate       String   @unique
  color       String?
  isActive    Boolean  @default(true) @map("is_active")
  isConfirmed Boolean  @default(false) @map("is_confirmed")
  notes       String?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz

  category    VehicleCategory     @relation(fields: [categoryId], references: [id])
  drivers     Driver[]
  assignments BookingAssignment[]

  @@index([categoryId])
  @@map("vehicles")
}

model Driver {
  id          String     @id @default(uuid()) @db.Uuid
  userId      String     @unique @map("user_id") @db.Uuid
  driverType  DriverType @default(EMPLOYEE) @map("driver_type") // D-10
  workPhone   String     @map("work_phone")
  vehicleId   String?    @map("vehicle_id") @db.Uuid // default vehicle
  isActive    Boolean    @default(true) @map("is_active")
  isAvailable Boolean    @default(false) @map("is_available") // on duty
  createdAt   DateTime   @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime   @updatedAt @map("updated_at") @db.Timestamptz

  user        User                        @relation(fields: [userId], references: [id])
  vehicle     Vehicle?                    @relation(fields: [vehicleId], references: [id])
  spareDays   DriverSpareDay[]
  offers      BookingDriverNotification[]
  assignments BookingAssignment[]

  @@map("drivers")
}

model DriverSpareDay {
  id          String   @id @default(uuid()) @db.Uuid
  driverId    String   @map("driver_id") @db.Uuid
  date        DateTime @db.Date // local date in Europe/Copenhagen
  sortOrder   Int      @default(0) @map("sort_order")
  createdById String   @map("created_by") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz

  driver Driver @relation(fields: [driverId], references: [id], onDelete: Cascade)

  @@unique([driverId, date])
  @@index([date])
  @@map("driver_spare_days")
}

// ───────────────────────── Pricing and quotes ─────────────────────────
// D-06 pricing model is open. Simple rule per category + currency for now.

model PricingRule {
  id               String   @id @default(uuid()) @db.Uuid
  categoryId       String   @map("category_id") @db.Uuid
  currency         Currency
  baseFareMinor    Int      @map("base_fare_minor")
  perKmMinor       Int      @default(0) @map("per_km_minor")
  perMinuteMinor   Int      @default(0) @map("per_minute_minor")
  minimumFareMinor Int      @default(0) @map("minimum_fare_minor")
  isActive         Boolean  @default(true) @map("is_active")
  isConfirmed      Boolean  @default(false) @map("is_confirmed")
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz

  category VehicleCategory @relation(fields: [categoryId], references: [id])

  @@unique([categoryId, currency])
  @@map("pricing_rules")
}

model Quote {
  id               String   @id @default(uuid()) @db.Uuid
  categoryId       String   @map("category_id") @db.Uuid
  pickupAddress    String   @map("pickup_address")
  pickupLat        Float    @map("pickup_lat")
  pickupLng        Float    @map("pickup_lng")
  dropoffAddress   String   @map("dropoff_address")
  dropoffLat       Float    @map("dropoff_lat")
  dropoffLng       Float    @map("dropoff_lng")
  pickupAt         DateTime @map("pickup_at") @db.Timestamptz
  passengers       Int
  distanceMeters   Int      @map("distance_meters")
  durationSeconds  Int      @map("duration_seconds")
  amountMinor      Int      @map("amount_minor")
  currency         Currency
  breakdown        Json
  expiresAt        DateTime @map("expires_at") @db.Timestamptz
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz

  category  VehicleCategory   @relation(fields: [categoryId], references: [id])
  checkouts CheckoutSession[]
  booking   Booking?

  @@map("quotes")
}

// ───────────────────────── Checkout and payments (§4.10) ─────────────────────────

model CheckoutSession {
  id                String         @id @default(uuid()) @db.Uuid
  quoteId           String         @map("quote_id") @db.Uuid
  idempotencyKey    String         @unique @map("idempotency_key")
  status            CheckoutStatus @default(PENDING)
  provider          String
  providerPaymentId String?        @unique @map("provider_payment_id")
  redirectUrl       String?        @map("redirect_url") // replayed on a repeated idempotency key
  customerEmail     String         @map("customer_email")
  customerName      String         @map("customer_name")
  customerPhone     String?        @map("customer_phone")
  passengerName     String?        @map("passenger_name")
  passengerPhone    String?        @map("passenger_phone")
  flightNumber      String?        @map("flight_number")
  notes             String?
  language          String         @default("en")
  bookingId         String?        @unique @map("booking_id") @db.Uuid
  expiresAt         DateTime       @map("expires_at") @db.Timestamptz
  createdAt         DateTime       @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime       @updatedAt @map("updated_at") @db.Timestamptz

  quote   Quote    @relation(fields: [quoteId], references: [id])
  booking Booking? @relation(fields: [bookingId], references: [id])

  @@index([status, expiresAt])
  @@map("checkout_sessions")
}

model Payment {
  id                String        @id @default(uuid()) @db.Uuid
  bookingId         String        @unique @map("booking_id") @db.Uuid
  provider          String
  providerPaymentId String        @unique @map("provider_payment_id")
  amountMinor       Int           @map("amount_minor")
  currency          Currency
  status            PaymentStatus
  createdAt         DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime      @updatedAt @map("updated_at") @db.Timestamptz

  booking Booking  @relation(fields: [bookingId], references: [id])
  refunds Refund[]

  @@map("payments")
}

model PaymentEvent {
  id              String   @id @default(uuid()) @db.Uuid
  provider        String
  providerEventId String   @map("provider_event_id")
  type            String
  payload         Json
  receivedAt      DateTime @default(now()) @map("received_at") @db.Timestamptz

  @@unique([provider, providerEventId])
  @@map("payment_events")
}

model Refund {
  id               String       @id @default(uuid()) @db.Uuid
  paymentId        String       @map("payment_id") @db.Uuid
  amountMinor      Int          @map("amount_minor")
  currency         Currency
  reason           String
  requestedById    String       @map("requested_by") @db.Uuid
  providerRefundId String?      @map("provider_refund_id")
  status           RefundStatus @default(PENDING)
  createdAt        DateTime     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime     @updatedAt @map("updated_at") @db.Timestamptz

  payment Payment @relation(fields: [paymentId], references: [id])

  @@map("refunds")
}

// ───────────────────────── Bookings and dispatch ─────────────────────────

model Booking {
  id             String        @id @default(uuid()) @db.Uuid
  reference      String        @unique
  status         BookingStatus @default(NEW)
  type           BookingType
  customerId     String        @map("customer_id") @db.Uuid
  quoteId        String        @unique @map("quote_id") @db.Uuid
  categoryId     String        @map("category_id") @db.Uuid
  pickupAddress  String        @map("pickup_address")
  pickupLat      Float         @map("pickup_lat")
  pickupLng      Float         @map("pickup_lng")
  dropoffAddress String        @map("dropoff_address")
  dropoffLat     Float         @map("dropoff_lat")
  dropoffLng     Float         @map("dropoff_lng")
  pickupAt       DateTime      @map("pickup_at") @db.Timestamptz
  passengers     Int
  passengerName  String?       @map("passenger_name")
  passengerPhone String?       @map("passenger_phone")
  flightNumber   String?       @map("flight_number")
  notes          String?
  language       String        @default("en")
  // Price snapshot: rate changes never rewrite past bookings
  priceMinor     Int           @map("price_minor")
  currency       Currency
  priceBreakdown Json          @map("price_breakdown")
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime      @updatedAt @map("updated_at") @db.Timestamptz

  customer      Customer                    @relation(fields: [customerId], references: [id])
  quote         Quote                       @relation(fields: [quoteId], references: [id])
  category      VehicleCategory             @relation(fields: [categoryId], references: [id])
  statusHistory BookingStatusHistory[]
  offers        BookingDriverNotification[]
  assignment    BookingAssignment?
  payment       Payment?
  checkout      CheckoutSession?
  notifications NotificationLog[]

  @@index([status])
  @@index([pickupAt])
  @@index([customerId])
  @@map("bookings")
}

model BookingStatusHistory {
  id         String         @id @default(uuid()) @db.Uuid
  bookingId  String         @map("booking_id") @db.Uuid
  fromStatus BookingStatus? @map("from_status")
  toStatus   BookingStatus  @map("to_status")
  actorId    String?        @map("actor_id") @db.Uuid
  reason     String?
  createdAt  DateTime       @default(now()) @map("created_at") @db.Timestamptz

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId, createdAt])
  @@map("booking_status_history")
}

// One row per offer to one driver
model BookingDriverNotification {
  id             String      @id @default(uuid()) @db.Uuid
  bookingId      String      @map("booking_id") @db.Uuid
  driverId       String      @map("driver_id") @db.Uuid
  status         OfferStatus @default(SENT)
  round          OfferRound
  chunk          Int?
  sentAt         DateTime    @default(now()) @map("sent_at") @db.Timestamptz
  viewedAt       DateTime?   @map("viewed_at") @db.Timestamptz
  respondedAt    DateTime?   @map("responded_at") @db.Timestamptz
  responseReason String?     @map("response_reason")
  expiresAt      DateTime    @map("expires_at") @db.Timestamptz

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  driver  Driver  @relation(fields: [driverId], references: [id])

  @@index([bookingId, status])
  @@index([driverId, status])
  @@map("booking_driver_notifications")
}

// Exactly one assignment per booking (unique booking_id)
model BookingAssignment {
  id           String           @id @default(uuid()) @db.Uuid
  bookingId    String           @unique @map("booking_id") @db.Uuid
  driverId     String           @map("driver_id") @db.Uuid
  vehicleId    String?          @map("vehicle_id") @db.Uuid
  method       AssignmentMethod
  assignedById String?          @map("assigned_by") @db.Uuid
  createdAt    DateTime         @default(now()) @map("created_at") @db.Timestamptz

  booking Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  driver  Driver   @relation(fields: [driverId], references: [id])
  vehicle Vehicle? @relation(fields: [vehicleId], references: [id])

  @@index([driverId])
  @@map("booking_assignments")
}

// Single row (id = 1). Values are placeholders until D-03 / D-04 / D-22 are confirmed.
model DispatchSettings {
  id                          Int           @id @default(1)
  regularStrategy             OfferStrategy @default(BROADCAST) @map("regular_strategy")
  offerTimeoutSeconds         Int           @default(600) @map("offer_timeout_seconds")
  sameDayOfferTimeoutSeconds  Int           @default(180) @map("same_day_offer_timeout_seconds")
  leadTimeMinutes             Int           @default(1440) @map("lead_time_minutes")
  sameDayThresholdHours       Int           @default(4) @map("same_day_threshold_hours")
  sameDayEscalationMinutes    Int           @default(10) @map("same_day_escalation_minutes")
  spareChunkSize              Int           @default(3) @map("spare_chunk_size")
  locationIntervalSeconds     Int           @default(15) @map("location_interval_seconds")
  locationDistanceMeters      Int           @default(50) @map("location_distance_meters")
  updatedAt                   DateTime      @updatedAt @map("updated_at") @db.Timestamptz

  @@map("dispatch_settings")
}

// ───────────────────────── Notifications ─────────────────────────

model NotificationLog {
  id        String              @id @default(uuid()) @db.Uuid
  channel   NotificationChannel
  recipient String
  template  String
  status    NotificationStatus  @default(QUEUED)
  error     String?
  bookingId String?             @map("booking_id") @db.Uuid
  createdAt DateTime            @default(now()) @map("created_at") @db.Timestamptz
  sentAt    DateTime?           @map("sent_at") @db.Timestamptz

  booking Booking? @relation(fields: [bookingId], references: [id])

  @@index([bookingId])
  @@index([createdAt])
  @@map("notification_logs")
}
